
@page "/Home"
@rendermode InteractiveServer
@using Services;
@using Domain;

<h1>Wells Fargo Account Creator</h1>

<label for="accountName">New Account Name:</label>
<input type="text" id="accountName" name="accountName" @bind="newAccountName">
<br>
<button class="btn btn-primary" @onclick="btnAddAccount_Click">Add Account</button>

<br>
<br>
<label for="accountList">Current Accounts:</label>
<select name="accountList" id="accountList" class="form-control"
        @bind="selectedAccountName" @bind:after="updateAccount"
        @bind:event="onchange">
    @if (accountList != null && accountList.Count > 0)
    {
        <option value="NoAccountSelected">Select an account</option>

        @foreach (string accName in accountList)
        {
            <option value="@accName">@accName</option>
        }
    }
    else
    {
        <option value="NoAccountSelected">No accounts available</option>
    }
</select>

<br>
<br>
<p>Account Balance: @strAccountBalance</p>

<label for="depositAmount">Deposit Amount:</label>
<input type="text" id="depositAmount" name="depositAmount" @bind="strDepositAmount">
<button class="btn btn-primary" @onclick="btnDeposit_Click">Deposit</button>

<br>
<br>

<label for="withdrawalAmount">Withdrawal Amount:</label>
<input type="text" id="withdrawalAmount" name="withdrawalAmount" @bind="strWithdrawalAmount">
<button class="btn btn-primary" @onclick="btnWithdrawal_Click">Withdraw</button>

<br>
<br>

<p>@errorMessage</p>

@code {

    private string newAccountName = string.Empty;
    private string selectedAccountName = "NoAccountSelected";
    private string strAccountBalance = string.Empty;
    private decimal accountBalance = 0.00m;
    private string strDepositAmount = string.Empty;
    private string strWithdrawalAmount = string.Empty;
    private string errorMessage = string.Empty;

    private List<string> accountList = new List<string>();
    AccountService acctService = new AccountService();

    protected override void OnInitialized()
    {
        accountList = acctService.GetAllAccounts();
    }

    private void updateAccount()
    {
        if (selectedAccountName != "NoAccountSelected")
        {
            accountBalance = acctService.GetAccountBalance(selectedAccountName);
            strAccountBalance = accountBalance.ToString();
        }
        else
        {
            strAccountBalance = "No account selected";
        }
    }

    private void btnDeposit_Click()
    {
        errorMessage = string.Empty;

        if (selectedAccountName == "NoAccountSelected")
        {
            errorMessage = "Please select an account first.";
            return;
        }

        if (!decimal.TryParse(strDepositAmount, out decimal amount) || amount <= 0)
        {
            errorMessage = "Please enter a valid positive deposit amount.";
            return;
        }

        acctService.Deposit(selectedAccountName, amount);

        accountBalance = acctService.GetAccountBalance(selectedAccountName);
        strAccountBalance = accountBalance.ToString();

        strDepositAmount = string.Empty;
        StateHasChanged();
    }

    private void btnWithdrawal_Click()
    {
        errorMessage = string.Empty;

        if (selectedAccountName == "NoAccountSelected")
        {
            errorMessage = "Please select an account first.";
            return;
        }

        if (!decimal.TryParse(strWithdrawalAmount, out decimal amount) || amount <= 0)
        {
            errorMessage = "Please enter a valid positive withdrawal amount.";
            return;
        }

        acctService.Withdrawal(selectedAccountName, amount);

        accountBalance = acctService.GetAccountBalance(selectedAccountName);
        strAccountBalance = accountBalance.ToString();

        strWithdrawalAmount = string.Empty;
        StateHasChanged();
    }

    private void btnAddAccount_Click()
    {
        Console.WriteLine("Add Account button clicked.");

        string accountName = newAccountName;
        acctService.CreateAccount(accountName, AccountType.Silver);

        accountList = acctService.GetAllAccounts();

        newAccountName = string.Empty;
        StateHasChanged();
    }
}
