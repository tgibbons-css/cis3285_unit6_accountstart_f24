@page "/Home"
@rendermode InteractiveServer
@using Services;
@using Domain;

<h1>Wells Fargo Account Creator</h1>

<label for="accountName">New Account Name:</label>
<input type="text" id="accountName" name="accountName" @bind="newAccountName">
<br>
<button class="btn btn-primary" @onclick="btnAddAccount_Click">Add Account</button>

<br>
<br>
<label for="accountList">Current Accounts:</label>
<select name="accountList" id="accountList" class="form-control" @bind="selectedAccountName" @bind:after="updateAccount" @bind:event="onchange">
    @if (accountList != null && accountList.Count > 0)
    {
        <option value="NoAccountSelected">Select an account</option>

        @foreach (string accName in accountList)
        {
            <option value="@accName">@accName</option>
        }
    }
    else
    {
        <option value="NoAccountSelected">No accounts available</option>
    }
</select>
<br>
<br>
<p>Account Balance: @strAccountBalance</p>

<label for="depositAmount">Deposit Amount:</label>
<input type="text" id="depositAmount" name="depositAmount" @bind="strDepositAmount">
<button class="btn btn-primary" @onclick="btnDeposit_Click">Deposit</button>
<br>

<label for="withdrawalAmount">Withdrawal Amount:</label>
<input type="text" id="withdrawalAmount" name="withdrawalAmount" @bind="strWithdrawalAmount">
<button class="btn btn-primary" @onclick="btnWithdrawal_Click">Withdrawal</button>
<br>

@if (!string.IsNullOrEmpty(strErrorMessage))
{
    <p class="text-danger">@strErrorMessage</p>
}

@code {

    private string newAccountName = string.Empty;              // name in the new account textbox
    private string selectedAccountName = "NoAccountSelected"; // account name selected from Acccout dropdown
    private string strAccountBalance = string.Empty;           // display for the account balance
    private decimal accountBalance = 0.00m;                   // numeric value of account balance
    private string strDepositAmount = string.Empty;            // amount to deposit as a string
    private string strWithdrawalAmount = string.Empty;         // amount to withdraw as a string
    private string strErrorMessage = string.Empty;             // validation message shown below the form

    private List<string> accountList = new List<string>();
    AccountService acctService = new AccountService();

    protected override void OnInitialized()
    {
        // Initialize account list if needed
        accountList = acctService.GetAllAccounts();
    }

    private void updateAccount()
    {
        if (string.Compare(selectedAccountName, "NoAccountSelected") != 0)
        {
            accountBalance = acctService.GetAccountBalance(selectedAccountName);
            strAccountBalance = accountBalance.ToString();
        }
        else
        {
            strAccountBalance = "No account selected";
        }
    }

    // Checks that an account is selected and the text is a positive number.
    // Sets strErrorMessage and returns false if anything is wrong.
    private bool TryGetAmount(string strAmount, out decimal amount)
    {
        amount = 0;
        if (string.Compare(selectedAccountName, "NoAccountSelected") == 0)
        {
            strErrorMessage = "Please select an account first.";
            return false;
        }
        if (!decimal.TryParse(strAmount, out amount))
        {
            strErrorMessage = "Please enter a valid number for the amount.";
            return false;
        }
        if (amount <= 0)
        {
            strErrorMessage = "The amount must be greater than zero.";
            return false;
        }
        strErrorMessage = string.Empty;
        return true;
    }

    private void btnDeposit_Click()
    {
        if (!TryGetAmount(strDepositAmount, out decimal amount))
        {
            return;
        }

        acctService.Deposit(selectedAccountName, amount);
        accountBalance = acctService.GetAccountBalance(selectedAccountName);
        strAccountBalance = accountBalance.ToString();
        strDepositAmount = string.Empty; // Clear the input field
        StateHasChanged();
    }

    private void btnWithdrawal_Click()
    {
        if (!TryGetAmount(strWithdrawalAmount, out decimal amount))
        {
            return;
        }

        acctService.Withdrawal(selectedAccountName, amount);
        accountBalance = acctService.GetAccountBalance(selectedAccountName);
        strAccountBalance = accountBalance.ToString();
        strWithdrawalAmount = string.Empty; // Clear the input field
        StateHasChanged();
    }

    private void btnAddAccount_Click()
    {
        Console.WriteLine("Add Account button clicked."); // For debugging

        string accountName = newAccountName.Trim();
        if (string.IsNullOrEmpty(accountName))
        {
            strErrorMessage = "Please enter an account name.";
            return;
        }
        if (accountList.Contains(accountName) || accountName == "NoAccountSelected")
        {
            strErrorMessage = $"An account named \"{accountName}\" already exists.";
            return;
        }

        acctService.CreateAccount(accountName, AccountType.Silver);
        strErrorMessage = string.Empty;

        accountList = acctService.GetAllAccounts();

        newAccountName = string.Empty; // Clear the input field
        StateHasChanged();

    }
}
